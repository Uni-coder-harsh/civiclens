# System Environment Configuration (dev/test/prod)
ENVIRONMENT=development
PROJECT_NAME=CivicLens
DEBUG=true

# Security Settings
# Generate keys with: openssl rand -hex 32
JWT_SECRET_KEY=9ca1029b8a3d4c3eb2d918b2c9a103019ca1029b8a3d4c3eb2d918b2c9a10301
JWT_REFRESH_SECRET_KEY=8fa1119b6e3e436fb1e878b1d9a243018fa1119b6e3e436fb1e878b1d9a24301
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL + PostGIS Configs
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=civiclens
DB_HOST=db
DB_PORT=5432

# Redis Caching Configs
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# MinIO Object Storage Configs
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=supersecretpassword
MINIO_SECURE=false
MINIO_BUCKET_NAME=civiclens-assets

# CORS Configs (Comma-separated list of origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# SlowAPI Rate Limiting Switch
RATE_LIMIT_ENABLED=true

# External Services Integrations
# Neon Database direct URL connection string (optional fallback)
# DATABASE_URL=postgresql://user:password@ep-name-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Upstash Redis direct URL connection string (optional fallback)
# REDIS_URL=rediss://default:password@name.upstash.io:6379
REDIS_URL=

# Resend Email Service Integration API Key and sender email
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@civiclens.com
